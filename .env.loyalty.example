# Copy only into a protected server environment. Never into Nuxt publicRuntimeConfig.
# disabled: default, no provider requests. development: genuine signed test cards.
# production: real issuer/signing credentials, after device acceptance tests.
LOYALTY_WALLET_MODE=disabled
# SMS: disabled by default. development never sends SMS and is refused in production.
CUSTOMER_SMS_MODE=disabled
CUSTOMER_SMS_DEV_CODE=
CUSTOMER_SMS_TWILIO_ACCOUNT_SID=
CUSTOMER_SMS_TWILIO_AUTH_TOKEN=
CUSTOMER_SMS_FROM=
# Existing authentication configuration must also be set (independent secret, >=32 bytes).
CUSTOMER_AUTH_SECRET=
CUSTOMER_ALLOWED_ORIGINS=http://localhost:8083
LOYALTY_OFFERS_BASE_URL=https://app.example.com

APPLE_WALLET_PASS_TYPE_ID=pass.com.example.smarteat.loyalty
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_PATH=
APPLE_WALLET_KEY_PATH=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PATH=
# Writable persistent directory. Common icon.png/icon@2x.png remain required.
# Admin artwork is stored under SHOPID/VERSION; retain previous versions.
APPLE_WALLET_ASSETS_PATH=
# Public HTTPS base URL, without /v1 suffix. Must match mount point.
APPLE_WALLET_WEB_SERVICE_URL=https://api.example.com/baseurl/api/v1/wallet/apple
LOYALTY_OPENSSL_PATH=openssl

GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY_PATH=
GOOGLE_WALLET_ORIGINS=https://app.example.com

# Backfill CLI only: set explicitly for the intended database, never in Nuxt.
# LOYALTY_BACKFILL_DATABASE_URL=mysql://user:password@localhost/database
# Disposable MySQL 8 integration tests only (creates/drops a random test database).
# DELIVERY_TEST_DATABASE_URL=mysql://test_user:password@localhost/test
